{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-mender",
  "account_id": "7612d5858e401cec8307c5e25c486494",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://eeejqyvtdvahofwoiicv.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_0d4jwkggGOYRbJqEpbWAvQ_2mFYAQDC"
  },
  "env": {
    // apimender.com: deploy to the existing live Worker in the owner's account.
    "apimender": {
      "name": "api-mender-live",
      "account_id": "7612d5858e401cec8307c5e25c486494",
      "routes": [
        { "pattern": "apimender.com", "custom_domain": true },
        { "pattern": "www.apimender.com", "custom_domain": true }
      ],
      // Watched API descriptions and their kept versions (lib/mender/watch.js).
      "kv_namespaces": [{ "binding": "MENDER_WATCH", "id": "647309a3aa774e7b957fe5662d4c2efc" }],
      // Who still calls an old API version, kept across restarts (migrations/).
      "d1_databases": [{ "binding": "MENDER_DB", "database_name": "api-mender-owner-live", "database_id": "26c55314-6c37-4ddf-808e-42155a76befd", "migrations_dir": "migrations" }],
      // Run the existing live cron every minute; the worker selects watches that are due.
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://eeejqyvtdvahofwoiicv.supabase.co",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_0d4jwkggGOYRbJqEpbWAvQ_2mFYAQDC",
        "SITE_ORIGIN": "https://apimender.com"
      }
    }
  }
}
