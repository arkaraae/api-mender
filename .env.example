# Local demo uses the labeled fixture and an on-disk SQLite database.
DATA_DIR=./data/current
DEMO_MODE=1
# Supabase public client settings for /live. The publishable key is safe for the browser;
# RLS policies in supabase/migrations/ protect workspace rows.
NEXT_PUBLIC_SUPABASE_URL=https://eeejqyvtdvahofwoiicv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0d4jwkggGOYRbJqEpbWAvQ_2mFYAQDC
# For authenticated API access, set unique random tokens for each tenant.
TENANT_TOKENS=
# Explicit tenant-to-GitHub-installation assignments, e.g. tenant_acme:12345
TENANT_INSTALLATIONS=
# GitHub App live PRs require all three values and a trusted installation mapping.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
# Optional model adapter. The fixture patch is deterministic without a model.
OPENAI_API_KEY=
MODEL_NAME=gpt-5.1
